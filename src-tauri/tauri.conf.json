{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hronomancer",
  "version": "2.0.0",
  "identifier": "com.netroforge.hronomancer",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "copyright": "Copyright Netroforge",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {},
      "rpm": {}
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "targets": "all"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Netroforge/hronomancer/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIxQTc1QkE4RTE0Q0Y5RkIKUldUNytVemhxRnVuSVl0dHpSMUdOZWp1NnFTYUl4R3F4UHcvQVN1ZlVPdEJVSnNxZ1RSS09aRUIK"
    }
  }
}
